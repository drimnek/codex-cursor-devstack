#!/usr/bin/python3
"""Compatibility entrypoint for the packaged agentd broker implementation."""
import sys
from pathlib import Path

_PLATFORM = Path(__file__).resolve().parents[1]
if str(_PLATFORM) not in sys.path:
    sys.path.insert(0, str(_PLATFORM))
_IMPLEMENTATION = _PLATFORM / "agentdev" / "broker" / "daemon.py"
exec(compile(_IMPLEMENTATION.read_bytes(), str(_IMPLEMENTATION), "exec"), globals(), globals())
