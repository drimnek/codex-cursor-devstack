ARG BASE_IMAGE=localhost/agent-dev/base:0.1.0
FROM ${BASE_IMAGE}

ARG CODEX_VERSION=0.147.0
ENV CODEX_HOME=/home/node/.codex
RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && codex --version \
    && mkdir -p /usr/local/share/agent-dev \
    && codex --version > /usr/local/share/agent-dev/codex-version.txt

WORKDIR /workspace
CMD ["codex"]
